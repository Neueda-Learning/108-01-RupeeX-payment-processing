
# MySQL settings
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rupeex
MYSQL_USER=
MYSQL_PASSWORD=

# Spring datasource (app connects to the `db` service)
# Use the DB host `db` (docker-compose service name)
# The URL will point to the database name above; change only if needed.
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Application settings
# e.g. 'dev' or 'prod'. Leave empty here to use compose defaults.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=${SERVER_PORT:-8080}

# Queue processing tuning
PAYMENT_QUEUE_POLL_INTERVAL_MS=1000

# Hibernate SQL logging (use INFO/WARN in prod to avoid log spam)
HIBERNATE_SQL_LOG_LEVEL=INFO
HIBERNATE_BINDER_LOG_LEVEL=INFO

# Allowed frontend origins for backend CORS (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Frontend API endpoints
# Server-side (inside frontend container) typically uses the app service name.
FRONTEND_API_BASE_URL=http://app:8080
# Browser-side endpoint used by client-side requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# SMTP (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=