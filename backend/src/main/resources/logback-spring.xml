<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Pulls in Spring Boot's default CONSOLE appender + root level wiring
         (logging.level.*), so we don't have to reimplement the console
         format Spring Boot already configures. -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- Dedicated rolling file for every transaction lifecycle event
         (payment created, validated, risk-scored, queued, settled, failed,
         cancelled, admin approved/declined, etc). Kept separate from the
         normal application log so it can be shipped/rotated/audited on its
         own, and is never polluted by unrelated framework log noise. -->
    <appender name="FILE_TRANSACTIONS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/transactions.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/transactions-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Wraps the file appender so writes happen on a dedicated background
         thread via an in-memory queue instead of blocking the request/
         processing thread that emits the transaction event. If the app
         crashes, includeCallerData=false and a bounded queue keep overhead
         low; neverBlock=true means logging pressure never stalls payment
         processing (worst case a burst of log lines is dropped, never the
         transaction itself). -->
    <appender name="ASYNC_TRANSACTIONS" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE_TRANSACTIONS"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- additivity=false: transaction events go ONLY to transactions.log,
         not to the console/root app log, to avoid duplication. -->
    <logger name="TRANSACTION_LOG" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_TRANSACTIONS"/>
    </logger>
</configuration>
