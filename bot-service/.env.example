# Bot service example environment for prototype
PORT=4001
AMQP_URL=amqp://guest:guest@localhost:5672
# NOTE: When running the backend via docker-compose.yml/docker-compose.prod.yml
# on the host, the Spring Boot app's host-mapped port is 8082, NOT 8080
# (8080 is commonly reserved for Jenkins on the same host). Only use 8080
# here if your backend is genuinely listening there (e.g. running it
# standalone outside Docker).
PAYMENT_API_URL=http://localhost:8082/api
BOT_API_KEY=
BOT_COMMAND_QUEUE=bot.commands
BOT_HIGH_VALUE_THRESHOLD=100000
# Backend requires originCountry/destinationCountry on every payment; the
# bot fills these in with defaults when the user doesn't specify them.
BOT_DEFAULT_ORIGIN_COUNTRY=IN
BOT_DEFAULT_DESTINATION_COUNTRY=IN
# Set START_WORKER=true to run the worker in the same process (prototype convenience)
START_WORKER=true

# On-premise Small Language Model (SLM) via Ollama
# Docker (recommended): `docker compose -f docker-compose.bot.yml up -d`
# starts Ollama in a container and auto-pulls both models below.
# Manual/local install alternative: https://ollama.com/download then
# `ollama pull qwen2.5:0.5b` and `ollama pull nomic-embed-text`.
SLM_ENABLED=true
SLM_BASE_URL=http://localhost:11434
SLM_MODEL=qwen2.5:0.5b
SLM_TIMEOUT_MS=8000
SLM_MIN_CONFIDENCE=0.5

# Small on-premise RAG (retrieval-augmented generation) layer.
# Knowledge base lives in bot-service/knowledge/*.md, embedded locally via
# Ollama's embeddings API (no external calls).
RAG_ENABLED=true
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=3
